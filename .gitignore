# Rust
/backend/target

# Data (database, generated master key). Two of them: `backend/data` is what
# `cargo run` creates beside the crate, `/data` is the volume
# docker-compose mounts at /data in the container.
/backend/data
/data
backups/
*.db
*.db-wal
*.db-shm
routarr.key

# Environment
.env

# Frontend
# Anywhere, not only at a package root: Vite writes its dependency cache to
# `frontend/src/node_modules/.vite`, which a leading-slash pattern misses.
node_modules/
# Astro's build output and its generated types. Cloudflare runs the build
# itself, so what is committed is the source, never the artefact.
/site/dist
/site/.astro
/frontend/dist

# Working documents, deliberately unpublished. Not build artefacts.
/docs

# A second checkout made with `git worktree add`, for parallel work.
/.worktrees
# Claude Code's personal settings and notes. `.claude/rules/` is shared and committed.
.claude/settings.local.json
CLAUDE.local.md

# IDE
.vscode
.idea
*.swp
*.swo

# Playwright
frontend/test-results/
frontend/playwright-report/

# Coverage reports, regenerated by `npm run coverage`.
frontend/coverage/

# The screenshot and locale scripts are run from the repository, so their
# bytecode caches land in the source tree.
__pycache__/
*.pyc
