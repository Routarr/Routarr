# Routarr's settings, one VARIABLE=value per line. The service reads this file at every start,
# and so does every command run by hand with the installed routarr.exe, such as
# `& "$env:ProgramFiles\Routarr\routarr.exe" reset-account` in PowerShell run as administrator.
# Every variable is described in
# https://github.com/Routarr/Routarr/blob/main/backend/.env.example
#
# Restart after a change: Restart-Service Routarr
# An upgrade keeps this file as you left it. Inside double quotes a backslash is written twice.

# The library, its master key, its API key, its backups and its log, in a folder only the
# service and the administrators read.
ROUTARR_DB_PATH="${ProgramData}\\Routarr\\routarr.db"

# Every address of the machine, port 9876. 127.0.0.1 keeps Routarr to this machine.
ROUTARR_HOST=0.0.0.0
ROUTARR_PORT=9876

# How Routarr was installed, which decides the commands its messages name.
ROUTARR_INSTALL=windows
