# Routarr's settings, one VARIABLE=value per line. /usr/bin/routarr reads this file at every
# start of the service and for every command run by hand, such as
# `sudo -u routarr routarr reset-account`. Every variable is described in
# https://github.com/Routarr/Routarr/blob/main/backend/.env.example
#
# Restart after a change: sudo systemctl restart routarr
# An upgrade keeps this file as you left it.

# The library, its master key, its API key and its backups, in a folder only routarr reads.
ROUTARR_DB_PATH=/var/lib/routarr/routarr.db

# Every address of the machine, port 9876. 127.0.0.1 keeps Routarr to this machine, behind a
# reverse proxy on it.
ROUTARR_HOST=0.0.0.0
ROUTARR_PORT=9876

# How Routarr was installed, which decides the commands its messages name.
ROUTARR_INSTALL=@INSTALL@
