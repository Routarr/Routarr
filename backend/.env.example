# ---------------------------------------------------------------- server
ROUTARR_PORT=9876
ROUTARR_HOST=0.0.0.0
# The database, and with it the master key, the API key and the backups: they
# all live in this file's directory. The path is *relative*, so the
# working directory decides which installation you open: `cargo run` from
# `backend/` and the release binary from the repository root are two separate
# libraries. The startup log prints the resolved directory. Set an absolute
# path here if you would rather not think about it.
ROUTARR_DB_PATH=./data/routarr.db
ROUTARR_FRONTEND_DIR=./frontend/dist

# Sub-path Routarr is served under, the equivalent of Servarr's "URL base".
# Leave empty unless a reverse proxy mounts it somewhere other than the root.
# `routarr`, `/routarr` and `/routarr/` are all accepted and normalised.
ROUTARR_BASE_PATH=

# ---------------------------------------------------------------- security
# The key a script sends as `X-Api-Key: <key>` or `Authorization: Bearer <key>`.
#
# Leave it empty in most cases. Routarr generates one on first start, and
# Settings can then regenerate it without a restart, or withdraw it in a mode
# with another way in (`apikey` refuses, the key being its only one). Setting
# it here *pins* the key: it wins over the stored one, and those two buttons go
# away, since a key minted in the interface would be replaced by this value on
# the next start. A pinned key has at least 32 characters, as
# `openssl rand -hex 32` prints one: a shorter one stops the start.
ROUTARR_API_KEY=

# Master key sealing the secrets stored in SQLite: the Arr API keys, the
# metadata source keys, the notification address and the signing secret. A
# base64-encoded 32-byte key, as `openssl rand -base64 32` prints one, is used
# as it is. Any other value is taken as a passphrase and stretched with
# Argon2id and a salt the database holds, so a backup carries what a restore
# with the same phrase needs. If unset, a key is generated next to the database
# as routarr.key. Back it up with routarr.db.
ROUTARR_SECRET_KEY=

# Set to the previous value while rotating ROUTARR_SECRET_KEY. Existing secrets
# are read with either key and rewritten under the new one at startup. Remove
# this once the log confirms the re-encryption.
ROUTARR_PREVIOUS_SECRET_KEY=

# A start refuses to make a new master key while the database holds values
# sealed with the one it had: routarr.key missing or empty beside a database
# copied alone, or deleted. Put the key back rather than set this. Set to true,
# the start makes a new key, and every Arr key, source key, notification
# address and signing secret has to be entered again.
ROUTARR_ALLOW_NEW_MASTER_KEY=false

# Read by `routarr restore` alone: the passphrase of an encrypted archive, when
# the database in place does not hold it. Left empty, the command asks for it
# at a prompt, which keeps it out of the shell history.
ROUTARR_BACKUP_PASSPHRASE=

# Extra origins allowed to call the API from a browser, comma separated. Empty
# means same-origin only, which is what a reverse proxy in front already gives
# you. Each entry is an origin exactly as a browser sends it,
# `scheme://host[:port]` with no path, because that is what the header is
# compared against. A wildcard is refused: these requests carry credentials,
# which a wildcard origin may not accompany.
ROUTARR_CORS_ORIGINS=

# Authentication. `apikey` (the default) asks for the key on every route but
# the few a signed-out browser or client needs (/ping, the languages,
# /auth/mode, /auth/logout, /openapi.json and the mode's own sign-in) and the
# webhook, which carries a token of its own. With no ROUTARR_API_KEY
# above, a key is generated into ROUTARR_DB_PATH's directory as
# `routarr.api_key` on first start and printed once in the log.
#
# `forms` adds a username and a password: one account, created on first start
# with a generated password written to routarr.password and printed once in the
# log. To reset a lost one, run `docker exec routarr /app/routarr reset-account`
# (or `routarr reset-account` outside Docker): it prints a new password, writes
# it to routarr.password and closes every session, with Routarr left running.
# `oidc` signs in through the provider configured below. `external`
# delegates to a reverse proxy and asks for nothing, so bind the port to that
# proxy and nowhere else. `none` opts out entirely, only on a network where
# anything that can reach Routarr may also move your files.
#
# The API key keeps working in every mode: a machine client cannot hold a
# cookie, and a header is immune to the forgery a cookie invites.
ROUTARR_AUTH=apikey

# Under ROUTARR_AUTH=none, the host names Routarr answers to, comma separated,
# beside any address and localhost: nas.lan,routarr.home.arpa. A page of
# another site can make its own name resolve to Routarr's address and then call
# it as if it were Routarr, so a request sent to a name not listed is refused.
ROUTARR_ALLOWED_HOSTS=

# The reverse proxies in front of Routarr, by IP address or range, comma
# separated: 172.18.0.2, or 172.18.0.0/16 for a proxy on a Docker network whose
# address changes when it is recreated. Sign-ins are throttled per client, and
# only a proxy listed here names the client in X-Forwarded-For, read from the
# last entry while each was written by a listed proxy. Any other peer is taken
# as the client, since anyone can write that header.
ROUTARR_TRUSTED_PROXIES=

# OpenID Connect, used only when ROUTARR_AUTH=oidc. The issuer is discovered
# from, not copied: Routarr reads {issuer}/.well-known/openid-configuration and
# takes the endpoints from there. The redirect URL is absolute because the
# provider compares it against what the client was registered with, and it ends
# in /api/v1/auth/oidc/callback.
#ROUTARR_OIDC_ISSUER=https://auth.example.com
#ROUTARR_OIDC_CLIENT_ID=routarr
#ROUTARR_OIDC_CLIENT_SECRET=
#ROUTARR_OIDC_REDIRECT_URL=https://routarr.example.com/api/v1/auth/oidc/callback
#
# Who may sign in, since a provider left at its defaults lets every account of
# its directory use every client, and each one signed in has full access. Name
# people by their `sub`, the identifier the provider never changes, or name
# groups: Routarr then asks for the `groups` scope and reads the claim named by
# ROUTARR_OIDC_GROUPS_CLAIM. Without either, the start stops, unless
# ROUTARR_OIDC_ALLOW_ANYONE=true says that every account of the provider may
# sign in.
#ROUTARR_OIDC_ALLOWED_SUBJECTS=
#ROUTARR_OIDC_ALLOWED_GROUPS=
#ROUTARR_OIDC_GROUPS_CLAIM=groups
#ROUTARR_OIDC_ALLOW_ANYONE=false

# ---------------------------------------------------------------- metadata
# Sources are an ordered list, kept in the interface (the Metadata sources
# screen) once it is saved there. Before that, TMDB_API_KEY below seeds it.
# Radarr and Sonarr are a source of their own and need no key at all, so
# everything below is optional: without any of it, only keyword and
# origin-country rules cannot match.

# TMDb. Accepts a v3 API key or a v4 read access token. Adds keywords and
# origin countries, which no Arr reports. Set before the source list is first
# saved, it lists TMDb after Radarr and Sonarr at startup. Once the list is
# saved, TMDb is turned on and off in the interface.
TMDB_API_KEY=

# Max parallel requests per fetched source during enrichment (1-16). A ceiling,
# not a target: each source is additionally paced to its own published rate, and
# AniList and Jikan lower this further on their own.
ROUTARR_METADATA_CONCURRENCY=4

# TMDb API root. Override to point at a mirror or a caching proxy.
ROUTARR_TMDB_BASE_URL=https://api.themoviedb.org/3

# OMDb. Free, but a key is mandatory: OMDb rejects an unauthenticated request.
# Keyed on the IMDb id, so it answers for items TMDb does not know.
# Get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
ROUTARR_OMDB_BASE_URL=https://www.omdbapi.com

# TheTVDB v4. The PIN is only needed for a *user-supported* key.
TVDB_API_KEY=
TVDB_SUBSCRIBER_PIN=
ROUTARR_TVDB_BASE_URL=https://api4.thetvdb.com/v4

# AniList and Jikan (MyAnimeList) authenticate nothing, so there is no key to
# set. They are enabled from the interface like any other source, and these
# roots exist so a mirror or a proxy can be used.
ROUTARR_ANILIST_BASE_URL=https://graphql.anilist.co
ROUTARR_JIKAN_BASE_URL=https://api.jikan.moe/v4

# ---------------------------------------------------------------- runtime
# Seconds before an outbound call (an Arr, a metadata source, the identity
# provider, the notification webhook) is abandoned.
ROUTARR_HTTP_TIMEOUT_SECS=20

ROUTARR_LOG_LEVEL=info
# `text` (default) or `json` for structured log shipping.
ROUTARR_LOG_FORMAT=text
