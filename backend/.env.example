# ---------------------------------------------------------------- server
ROUTARR_PORT=9876
ROUTARR_HOST=0.0.0.0
# The database. The master key, the API key and the backups live in its directory. A relative
# path follows the working directory: `cargo run` from `backend/` and the release binary from
# the repository root open two different libraries, and the start logs the resolved directory.
ROUTARR_DB_PATH=./data/routarr.db
# The built interface. Unset, the server takes `frontend/dist` beside it, as in
# the image, or one level up, as `cargo run` from `backend/` needs.
# ROUTARR_FRONTEND_DIR=/path/to/frontend/dist

# Sub-path Routarr is served under, the equivalent of Servarr's "URL base".
# Leave empty unless a reverse proxy mounts it somewhere other than the root.
# `routarr`, `/routarr` and `/routarr/` are all accepted and normalised.
ROUTARR_BASE_PATH=

# ---------------------------------------------------------------- security
# The key a script sends as `X-Api-Key: <key>` or `Authorization: Bearer <key>`.
#
# Usually empty: Routarr generates one on first start, and Settings can regenerate it, or
# withdraw it in a mode with another way in. Set here, the key is pinned: it wins over the
# stored one and Settings cannot change it. At least 32 characters (`openssl rand -hex 32`),
# or the start stops.
ROUTARR_API_KEY=

# Master key sealing the secrets stored in SQLite: the Arr API keys, the
# metadata source keys, the notification address and the signing secret. A
# base64-encoded 32-byte key, as `openssl rand -base64 32` prints one, is used
# as it is. Any other value is taken as a passphrase and stretched with
# Argon2id and a salt the database holds, so a backup carries what a restore
# with the same phrase needs. If unset, a key is generated next to the database
# as routarr.key, which every archive in backups/ carries.
ROUTARR_SECRET_KEY=

# Set to the previous value while rotating ROUTARR_SECRET_KEY. Existing secrets
# are read with either key and rewritten under the new one at startup. Remove
# this once the log confirms the re-encryption. Moving from the generated
# routarr.key to a key of your own, the previous value is that file's content.
ROUTARR_PREVIOUS_SECRET_KEY=

# A start refuses to make a new master key while the database holds values
# sealed with the one it had: routarr.key missing or empty beside a database
# copied alone, or deleted. Put the key back rather than set this. Set to true,
# the start makes a new key, and every Arr key, source key, notification
# address and signing secret has to be entered again.
ROUTARR_ALLOW_NEW_MASTER_KEY=false

# Read by `routarr restore` and `routarr decrypt-backup` alone: the passphrase
# of an encrypted archive, when the database in place does not hold it. Left
# empty, the command asks for it at a prompt, which keeps it out of the shell
# history.
ROUTARR_BACKUP_PASSPHRASE=

# A second folder each backup archive is copied to, best mounted from a NAS or
# another disk, so the loss of the disk holding the database leaves a copy.
# Absolute, outside the database's folder, and writable by the user Routarr
# runs as. The copy runs apart from the backup, so a share that sleeps or hangs
# delays only the copy. The first copy leaves a `.routarr-backup-copy` file in
# the folder: a folder without it afterwards reads as a share not mounted, and
# nothing is copied until the Backups card is told to start the copy there.
# A lost disk is restored from the copy with `routarr restore <path>`.
# ROUTARR_BACKUP_COPY_DIR=/mnt/nas/routarr-backups

# Extra origins allowed to call the API from a browser, comma separated, each exactly as a
# browser sends it: `scheme://host[:port]`, no path. Empty means same-origin only. A wildcard
# is refused, since these requests carry credentials.
ROUTARR_CORS_ORIGINS=

# Authentication. `apikey` (the default) asks for the key on every route but
# the few a signed-out browser or client needs (/ping, the languages,
# /auth/mode, /auth/logout, /openapi.json and the mode's own sign-in) and the
# webhook, which carries a token of its own. With no ROUTARR_API_KEY
# above, a key is generated into ROUTARR_DB_PATH's directory as
# `routarr.api_key` on first start, and the log names that file.
#
# `forms` adds a username and a password: one account, created on first start
# with a generated password written to routarr.password, whose path the log
# names. To reset a lost one, run `docker exec routarr /app/routarr reset-account`
# (or `routarr reset-account` outside Docker): it prints a new password, writes
# it to routarr.password and closes every session, with Routarr left running.
# `oidc` signs in through the provider configured below. `external`
# delegates to a reverse proxy and asks for nothing, so bind the port to that
# proxy and nowhere else. `none` opts out entirely, only on a network where
# anything that can reach Routarr may also move your files.
#
# The API key keeps working in every mode: a machine client cannot hold a
# cookie, and a header is immune to the forgery a cookie invites.
ROUTARR_AUTH=apikey

# Under ROUTARR_AUTH=none, the host names Routarr answers to, comma separated,
# beside any address and localhost: nas.lan,routarr.home.arpa. A page of
# another site can make its own name resolve to Routarr's address and then call
# it as if it were Routarr, so a request sent to a name not listed is refused.
ROUTARR_ALLOWED_HOSTS=

# The reverse proxies in front of Routarr, by IP address or range, comma
# separated: 172.18.0.2. Sign-ins are throttled per client, and only a proxy
# listed here names the client in X-Forwarded-For, read from the last entry
# while each was written by a listed proxy. Any other peer is taken as the
# client, since anyone can write that header. Give the proxy a fixed address on
# its Docker network (ipv4_address) and list that one: every peer inside a
# listed range, such as 172.18.0.0/16, chooses the address its sign-ins count
# against, each container of a shared network included, which the start says.
ROUTARR_TRUSTED_PROXIES=

# OpenID Connect, used only when ROUTARR_AUTH=oidc. Routarr reads the endpoints from
# {issuer}/.well-known/openid-configuration. The redirect URL is absolute, as registered with the
# provider, and ends in /api/v1/auth/oidc/callback.
#ROUTARR_OIDC_ISSUER=https://auth.example.com
#ROUTARR_OIDC_CLIENT_ID=routarr
#ROUTARR_OIDC_CLIENT_SECRET=
#ROUTARR_OIDC_REDIRECT_URL=https://routarr.example.com/api/v1/auth/oidc/callback
#
# Who may sign in, since a provider left at its defaults lets every account of
# its directory use every client, and each one signed in has full access. Name
# people by their `sub`, the identifier the provider never changes, or name
# groups: Routarr then asks for the `groups` scope and reads the claim named by
# ROUTARR_OIDC_GROUPS_CLAIM. Without either, the start stops, unless
# ROUTARR_OIDC_ALLOW_ANYONE=true says that every account of the provider may
# sign in.
#ROUTARR_OIDC_ALLOWED_SUBJECTS=
#ROUTARR_OIDC_ALLOWED_GROUPS=
#ROUTARR_OIDC_GROUPS_CLAIM=groups
#ROUTARR_OIDC_ALLOW_ANYONE=false
#
# Who may sign in to read alone: the library, the proposals, the history and
# the tasks, never a move or a setting, what an application key with the read
# scope reads, and no one's name but their own. Someone the lists above let in
# as well has full access. A name in a list above and here, or
# ROUTARR_OIDC_ALLOW_ANYONE=true beside these, stops the start. The level is
# set at sign-in and kept for the session, a day at most, and a start with
# other lists ends every session the earlier ones opened. Groups have to be in
# the ID token: Authelia keeps them in userinfo unless a claims policy adds
# them, and Keycloak needs a group membership mapper.
#ROUTARR_OIDC_READ_SUBJECTS=
#ROUTARR_OIDC_READ_GROUPS=

# ---------------------------------------------------------------- metadata
# Sources are an ordered list, kept in the interface (the Metadata sources
# screen) once it is saved there. Before that, TMDB_API_KEY below seeds it.
# Radarr and Sonarr are a source of their own and need no key at all, so
# everything below is optional: without any of it, only keyword and
# origin-country rules cannot match.

# TMDB. Accepts a v3 API key or a v4 read access token. Adds keywords and
# origin countries, which no Arr reports. Set before the source list is first
# saved, it lists TMDB after Radarr and Sonarr at startup. Once the list is
# saved, TMDB is turned on and off in the interface.
TMDB_API_KEY=

# Max parallel requests per fetched source during enrichment (1-16). A ceiling,
# not a target: each source is additionally paced to its own published rate, and
# AniList, Tenrai and MyAnimeList lower this further on their own.
ROUTARR_METADATA_CONCURRENCY=4

# TMDB API root. Override to point at a mirror or a caching proxy.
ROUTARR_TMDB_BASE_URL=https://api.themoviedb.org/3

# OMDb. Free, but a key is mandatory: OMDb rejects an unauthenticated request.
# Keyed on the IMDb id, so it answers for items TMDB does not know. A free key
# allows 1,000 requests a day, which the "OMDb requests a day" setting budgets,
# and its data is licensed under CC BY-NC 4.0.
# Get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
ROUTARR_OMDB_BASE_URL=https://www.omdbapi.com

# TheTVDB v4, for series alone. Its key is free for a project earning under
# $50,000 a year that credits TheTVDB, as the interface does. The PIN is only
# needed for a *user-supported* key. Both can be typed on the Metadata sources
# screen instead, and what is saved there wins over these.
TVDB_API_KEY=
TVDB_SUBSCRIBER_PIN=
ROUTARR_TVDB_BASE_URL=https://api4.thetvdb.com/v4

# AniList and Tenrai (MyAnimeList) authenticate nothing, so there is no key to
# set. They are enabled from the interface like any other source, and these
# roots exist so a mirror or a proxy can be used.
ROUTARR_ANILIST_BASE_URL=https://graphql.anilist.co
ROUTARR_TENRAI_BASE_URL=https://api.tenrai.org/v1

# MyAnimeList's official API, beside Tenrai: what MyAnimeList itself answers
# when a scraping service fails. Its agreement lets nobody share a client ID,
# so each installation makes its own: sign in at
# https://myanimelist.net/apiconfig/create, choose the App Type "other", give
# any redirect URL such as http://localhost/oauth, then copy the client ID. It
# can be typed on the Metadata sources screen instead, which wins.
MAL_CLIENT_ID=
ROUTARR_MYANIMELIST_BASE_URL=https://api.myanimelist.net/v2

# Where the anime identifier table is downloaded from, when somebody asks for it on the Metadata
# sources screen or turns its weekly download on: a mirror, or another table in the same format.
ROUTARR_ANIME_IDS_URL=https://raw.githubusercontent.com/Fribb/anime-lists/master/anime-list-mini.json

# ---------------------------------------------------------------- runtime
# Seconds before an outbound call (an Arr, a metadata source, the identity
# provider, the notification webhook) is abandoned.
ROUTARR_HTTP_TIMEOUT_SECS=20

# Seconds before listing a whole library from Radarr or Sonarr, or downloading
# the anime identifier table, is abandoned, and the largest listing read, in
# MiB. A library of tens of thousands of titles on a slow NAS can outgrow either.
ROUTARR_LIBRARY_TIMEOUT_SECS=300
ROUTARR_MAX_LIBRARY_MIB=256

# A certificate authority of your own, for an Arr served over HTTPS with a
# homelab certificate: every folder named replaces the system's store, which
# therefore comes first.
# SSL_CERT_DIR=/etc/ssl/certs:/certs

ROUTARR_LOG_LEVEL=info
# `text` (default) or `json` for structured log shipping.
ROUTARR_LOG_FORMAT=text
# Expert override: a tracing filter such as `routarr=debug,sqlx=info`, which
# replaces ROUTARR_LOG_LEVEL whole. The start says so when it is set.
# RUST_LOG=
