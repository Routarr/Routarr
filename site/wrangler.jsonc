/**
 * The showcase site as a Worker serving static assets, which is what replaced
 * Pages. No `main`: there is no Worker code, only the files Astro builds.
 *
 * `dist/_headers` is what carries the CSP, the security headers and the
 * caching rules; Astro copies it there from `public/`. Cloudflare applies it
 * from the assets directory, exactly as Pages did, which is the one property
 * worth checking after the first deployment: without it the site still renders
 * but ships none of its headers.
 */
{
  "name": "routarr",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist"
  }
}
