/**
 * The showcase site as a Worker serving static assets. No `main`: there is no
 * Worker code, only the files Astro builds. `.github/workflows/site.yml`
 * deploys it from a release's tag with the `wrangler` this package pins, and
 * Cloudflare's own build of main only uploads a version it never deploys.
 *
 * `dist/_headers` is what carries the CSP, the security headers and the
 * caching rules, and Astro copies it there from `public/`. Cloudflare applies it
 * from the assets directory, which is the one property worth checking after a
 * deployment: without it the site still renders but ships none of its headers.
 *
 * `not_found_handling` serves `404.html` for a path nothing resolves. Without
 * it the Worker answers an empty 404, and `serve.mjs`, which serves that page
 * on a miss, would hide the difference from `verify.mjs`.
 */
{
  "name": "routarr",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
