---
import Base from './Base.astro';
import { useTranslations, type Locale } from '../i18n';

import Why from '../components/sections/Why.astro';
import Explain from '../components/sections/Explain.astro';
import Folders from '../components/sections/Folders.astro';
import Features from '../components/sections/Features.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';

/**
 * The second page: the sections the landing leaves out, reached from its last card and
 * from the Index panel.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} page="how">
  {/* The hero holds the landing's `h1`, so this page needs its own. */}
  <section id="detail-head">
    <div class="wrap section-head">
      <span class="eyebrow">{t('detail.span')}</span>
      <h1 set:html={t('detail.h1')} />
      <p>{t('detail.p')}</p>
    </div>
  </section>

  {/* The order `detail.p` announces and `DETAIL_SECTIONS` numbers. The gap comes first:
      Explain answers the question Why poses. */}
  <Why locale={locale} />
  <Explain locale={locale} />
  <Folders locale={locale} />
  <Features locale={locale} />
  <Faq locale={locale} />
  <Cta locale={locale} />
</Base>
