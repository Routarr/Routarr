---
import Base from './Base.astro';
import type { Locale } from '../i18n';

import Hero from '../components/sections/Hero.astro';
import Rules from '../components/sections/Rules.astro';
import Safety from '../components/sections/Safety.astro';
import Start from '../components/sections/Start.astro';
import More from '../components/sections/More.astro';

/**
 * The landing page, one markup that every locale's route renders. Each section costs a
 * phone several screens, so the page stays short and the rest goes to the detail page.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} page="landing">
  <Hero locale={locale} />
  <Rules locale={locale} />
  <Safety locale={locale} />
  <Start locale={locale} />
  <More locale={locale} />
</Base>
