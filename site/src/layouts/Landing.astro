---
import Base from './Base.astro';
import type { Locale } from '../i18n';

import Hero from '../components/sections/Hero.astro';
import Rules from '../components/sections/Rules.astro';
import Safety from '../components/sections/Safety.astro';
import Start from '../components/sections/Start.astro';
import More from '../components/sections/More.astro';

/**
 * The landing page, once. Four routes render it with a different locale, which
 * is what stops the translations drifting from the markup: there is only one
 * markup.
 *
 * Four blocks, and the choice of which four is the whole point. A section built
 * for a wide window unfolds into a list on a phone, and a comparison laid out
 * as a list compares nothing, so every section added here costs screens of
 * scrolling. The hero is already the demonstration, so nothing below it
 * repeats it: what decides, what refuses to write, how to run it, and a door
 * to the rest.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} page="landing">
  <Hero locale={locale} />
  <Rules locale={locale} />
  <Safety locale={locale} />
  <Start locale={locale} />
  <More locale={locale} />
</Base>
