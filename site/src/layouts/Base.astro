---
import { version } from '../version';
import { LANGUAGES, useTranslations, pathFor, type Key, type Locale, type Page } from '../i18n';
import { themeBootstrap } from '../theme-bootstrap';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  locale: Locale;
  page?: Page;
}

const { locale, page = 'landing' } = Astro.props;
const t = useTranslations(locale);

/* Each page states its own title and descriptions. Everything else in the
   head is the same for every page. The landing's card description is shorter
   than its search one, and the other pages' cards say what their page holds. */
const HEAD: Record<Page, { title: Key; description: Key; card: Key }> = {
  landing: { title: 'head.title', description: 'head.description', card: 'head.og-description' },
  how: { title: 'head.title.how', description: 'head.description.how', card: 'head.description.how' },
  api: { title: 'head.title.api', description: 'head.description.api', card: 'head.description.api' },
};
const title = t(HEAD[page].title);
const description = t(HEAD[page].description);

/**
 * Absolute URLs, all from `site` in astro.config.mjs.
 *
 * The canonical link, the OpenGraph URL and every `hreflang` come from this
 * one value rather than from literals repeated across the four pages, which is
 * the only arrangement in which they cannot disagree.
 */
const origin = Astro.site!;
const canonical = new URL(pathFor(locale, page), origin).href;

/** What Open Graph calls each language. The page's `lang` is the bare code. */
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', fr: 'fr_FR', de: 'de_DE', es: 'es_ES' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Routarr',
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: 'Media library automation',
  operatingSystem: 'Docker (Linux, amd64 and arm64)',
  softwareVersion: version,
  inLanguage: locale,
  description,
  url: `${origin.href}`,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang={locale} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    {/* Every translation names every other, itself included, and `x-default`
        points at English: a search engine that finds one page must be able to
        reach the rest. */}
    {
      LANGUAGES.map((language) => (
        <link
          rel="alternate"
          hreflang={language.code}
          href={new URL(pathFor(language.code, page), origin).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en', page), origin).href} />

    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Routarr" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      LANGUAGES.filter((language) => language.code !== locale).map((language) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[language.code]} />
      ))
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t(HEAD[page].card)} />
    <meta property="og:image" content={new URL('/assets/og.png', origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    {/* `is:inline` on purpose: this has to run before first paint to avoid a
        flash of the wrong theme, so it cannot be bundled and deferred, and
        its hash is what `_headers` allows through the CSP. */}
    <script is:inline set:html={themeBootstrap} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema, null, 2)} />
  </head>

  <body>
    <a class="skip" href="#main">{t('page.skip')}</a>

    <Header locale={locale} page={page} />

    {/* Offered, never imposed: `site.js` fills this in when the browser prefers
        a language the site speaks and the reader has not already chosen one. */}
    <div class="lang-hint" id="lang-hint" role="region" aria-live="polite" aria-label={t('header.nav.language')} hidden></div>

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    {/* Served as a file, not bundled. Astro would inline a script this small,
        and an inline script needs its own `sha256-` in `_headers`. The policy
        allows exactly one, the theme bootstrap above, so that there is never a
        hash to recompute for an ordinary edit. Deferred and optional: the site
        reads and navigates without it. */}
    <script is:inline src="/assets/site.js" defer></script>
  </body>
</html>
