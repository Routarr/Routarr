---
import Base from './Base.astro';
import Terminal from '../components/Terminal.astro';
import Reference from '../components/sections/Reference.astro';
import { useTranslations, type Key, type Locale } from '../i18n';

/**
 * The third page, for whoever wires Routarr into something else: what the API
 * is for, the three steps to a first answer, as the landing lists the install,
 * then every operation of the release the page names, read from its contract.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* What goes on the wire, which no language translates. */
const STEPS: { number: string; fact: string; note: Key }[] = [
  { number: '01', fact: 'X-Api-Key: rtr_…', note: 'api.step.1' },
  { number: '02', fact: 'GET /api/v1/route', note: 'api.step.2' },
  { number: '03', fact: 'GET /api/v1/openapi.json', note: 'api.step.3' },
];

const CALL = String.raw`curl -fsS -H "X-Api-Key: $ROUTARR_KEY" \
  "http://localhost:9876/api/v1/route?type=movie&tmdb=149" \
  | jq '.answers[0]
      | {category, folder: .root_folder.path, action, rule}'`;

/* What the jq filter of CALL prints from an instance's answer, the fields in
   the order it builds them: a change to either changes the other. TMDB 149
   is Akira, which the hero's plan shows held in /movies, hence a move, and
   the rule carries the name a reader of this language would have given it. */
const ANSWER = `{
  "category": "anime",
  "folder": "/movies/anime",
  "action": "move",
  "rule": "${t('page.text.3')}"
}`;
---

<Base locale={locale} page="api">
  <section id="api-head">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{t('api.span')}</span>
        <h1 set:html={t('api.h1')} />
        <p>{t('api.p')}</p>
      </div>

      <div class="install">
        <ol class="install-steps">
          {
            STEPS.map((step) => (
              <li>
                <span class="install-n">{step.number}</span>
                <div>
                  <p class="install-cmd">{step.fact}</p>
                  <p class="install-note" set:html={t(step.note)} />
                </div>
              </li>
            ))
          }
        </ol>

        <div class="install-aside">
          <Terminal locale={locale} name="route.sh" code={CALL} />
          <Terminal locale={locale} name="answer.json" code={ANSWER} />
        </div>
      </div>

      <div class="callout">
        <p set:html={t('api.stable')} />
      </div>
    </div>
  </section>

  <Reference locale={locale} />
</Base>
