---
import { useTranslations, type Locale } from '../i18n';

/* The name is in the copy button's label: two buttons on one page that both
   answer to "Copy" leave a screen reader guessing which block each copies.
   `code` is shown as written. A block highlighted by hand passes `markup`
   instead, spans the page writes around words no language translates. */
interface Props { locale: Locale; name: string; code?: string; markup?: string }
const { locale, name, code = '', markup } = Astro.props;
const t = useTranslations(locale);
---

<div class="terminal">
  <div class="terminal-bar">
    <span></span><span></span><span></span>
    <span class="name">{name}</span>
    <button class="copy-btn" type="button" aria-label={`${t('page.button.copy')} – ${name}`} aria-live="polite" data-copied={t('page.button.copied')} data-failed={t('page.button.copy-failed')} data-failed-mac={t('page.button.copy-failed.mac')}>{t('page.button.copy')}</button>
  </div>
  <pre tabindex="0">{markup ? <code set:html={markup} /> : <code>{code}</code>}</pre>
</div>
