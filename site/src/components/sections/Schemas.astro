---
import { useTranslations, type Locale } from '../../i18n';
import { schemas } from '../../contract';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * The types the operations take and answer, each the target of the links in
 * the reference above: `#schema-Decision` opens the entry it names, which
 * `site.js` does where the browser does not.
 */
const SCHEMAS = schemas();
---

<section id="schemas">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('api.schemas.span')}</span>
      <h2 set:html={t('api.schemas.h2')} />
      <p>{t('api.schemas.p')}</p>
    </div>

    <div class="ref-list">
      {
        SCHEMAS.map((schema) => (
          <details class="ref-item ref-schema" id={`schema-${schema.name}`}>
            <summary>
              <code class="ref-name">{schema.name}</code>
              <span class="ref-line" lang="en" set:html={schema.note} />
            </summary>
            <div class="ref-body">
              <div class="ref-prose" lang="en" set:html={schema.more} />
              {schema.fields.length > 0 ? (
                <dl class="ref-fields">
                  {schema.fields.map((field) => (
                    <div>
                      <dt>
                        <code>{field.name}</code>
                        <span class="ref-type" set:html={field.type} />
                        {field.required && <span class="ref-required">{t('api.ref.required')}</span>}
                      </dt>
                      <dd lang="en" set:html={field.description} />
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="ref-type" set:html={schema.type} />
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
