---
import { useTranslations, pathFor, type Key, type Locale } from '../../i18n';
import Arrow from '../icons/Arrow.astro';
import GitHub from '../icons/GitHub.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/* `#start` is on the landing page, not on this one, so the link is absolute
   within the site. An anchor to a section that is not here scrolls nowhere. */
const install = `${pathFor(locale)}#start`;

/**
 * A close that sums up rather than exhorts. Each line is something the page
 * proved a few screens above, so the last thing a hesitant reader sees is the
 * three facts that answer the three reasons not to install it, and the slogan
 * does not carry the section on its own.
 */
const RECAP: { claim: Key; detail: Key }[] = [
  { claim: 'cta.recap', detail: 'cta.recap.p' },
  { claim: 'cta.recap.2', detail: 'cta.recap.p.2' },
  { claim: 'cta.recap.3', detail: 'cta.recap.p.3' },
];
---

<section id="cta">
  <div class="wrap cta-close">
    <div class="cta-say">
      <h2 set:html={t('cta.h2')} />
      <p>{t('cta.p')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={install}>
          <Arrow />
          {t('cta.a.install')}
        </a>
        <a class="btn btn-secondary" href="https://github.com/Routarr/Routarr">
          <GitHub />
          {t('cta.a.github')}
        </a>
      </div>
    </div>

    <div class="cta-recap">
      <p class="cta-recap-band">{t('cta.band')}</p>
      {
        RECAP.map((line) => (
          <div class="cta-line">
            <span class="cta-mark" aria-hidden="true">✓</span>
            <div>
              <b>{t(line.claim)}</b>
              <p>{t(line.detail)}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
