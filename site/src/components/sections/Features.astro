---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * Independent capabilities have one dimension, so a `dl` rather than a framed grid, with
 * `dt` terms rather than headings that would make an outline of labels. Each line leads
 * with what the capability does and gives its name second.
 */
const SPEC: { group: Key; fact: Key; name: Key; note: Key }[] = [
  { group: 'features.k', fact: 'features.fact', name: 'features.h3', note: 'features.p.2' },
  { group: 'features.k.2', fact: 'features.fact.2', name: 'features.h3.2', note: 'features.p.3' },
  { group: 'features.k.3', fact: 'features.fact.3', name: 'features.h3.3', note: 'features.p.4' },
  { group: 'features.k.4', fact: 'features.fact.4', name: 'features.h3.4', note: 'features.p.5' },
  { group: 'features.k.5', fact: 'features.fact.5', name: 'features.h3.5', note: 'features.p.6' },
  { group: 'features.k.6', fact: 'features.fact.6', name: 'features.h3.6', note: 'features.p.7' },
];
---

<section id="features">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('features.span')}</span>
      <h2 set:html={t('features.h2')} />
      <p>{t('features.p')}</p>
    </div>

    <dl class="spec">
      {
        SPEC.map((row) => (
          <div class="spec-item">
            <dt>{t(row.group)}</dt>
            <dd>
              <p class="spec-fact">{t(row.fact)}<span>{t(row.name)}</span></p>
              <p set:html={t(row.note)} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
