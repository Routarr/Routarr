---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * Independent capabilities have one dimension, so a `dl` rather than a framed grid, with
 * `dt` terms rather than headings that would make an outline of labels. Each term has two
 * `dd`, its fact and its sentence, so a screen reader and the Markdown copy part them.
 */
const ROWS: { name: Key; fact: Key; note: Key }[] = [
  { name: 'features.name', fact: 'features.fact', note: 'features.note' },
  { name: 'features.name.2', fact: 'features.fact.2', note: 'features.note.2' },
  { name: 'features.name.3', fact: 'features.fact.3', note: 'features.note.3' },
  { name: 'features.name.4', fact: 'features.fact.4', note: 'features.note.4' },
  { name: 'features.name.5', fact: 'features.fact.5', note: 'features.note.5' },
  { name: 'features.name.6', fact: 'features.fact.6', note: 'features.note.6' },
  { name: 'features.name.7', fact: 'features.fact.7', note: 'features.note.7' },
];
---

<section id="features">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('features.span')}</span>
      <h2 set:html={t('features.h2')} />
      <p>{t('features.p')}</p>
    </div>

    <dl class="spec">
      {
        ROWS.map((row) => (
          <div>
            <dt>{t(row.name)}</dt>
            <dd class="spec-fact">{t(row.fact)}</dd>
            <dd class="spec-note" set:html={t(row.note)} />
          </div>
        ))
      }
    </dl>
  </div>
</section>
