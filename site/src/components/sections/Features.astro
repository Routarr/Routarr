---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * The back of the box, as a list of definitions rather than as a grid. There
 * is only one dimension here — six independent capabilities, each a term and
 * what it means — so the framed table it used to sit in was drawing a second
 * axis that does not exist, and was the fourth such object on a page whose
 * companion carries one.
 *
 * The fact carries the line and the name is a label: a specification sheet is
 * read for what a thing does, not for what it is called, and the name is the
 * half you can guess from the fact rather than the other way round.
 *
 * The terms are `dt`, not headings. Six `h3`s made an outline out of six
 * labels, and a label is not a level.
 */
const SPEC: { group: Key; fact: Key; name: Key; note: Key }[] = [
  { group: 'features.k', fact: 'features.fact', name: 'features.h3', note: 'features.p.2' },
  { group: 'features.k.2', fact: 'features.fact.2', name: 'features.h3.2', note: 'features.p.3' },
  { group: 'features.k.3', fact: 'features.fact.3', name: 'features.h3.3', note: 'features.p.4' },
  { group: 'features.k.4', fact: 'features.fact.4', name: 'features.h3.4', note: 'features.p.5' },
  { group: 'features.k.5', fact: 'features.fact.5', name: 'features.h3.5', note: 'features.p.6' },
  { group: 'features.k.6', fact: 'features.fact.6', name: 'features.h3.6', note: 'features.p.7' },
];
---

<section id="features">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('features.span')}</span>
      <h2 set:html={t('features.h2')} />
      <p>{t('features.p')}</p>
    </div>

    <dl class="spec">
      {
        SPEC.map((row) => (
          <div class="spec-item">
            <dt>{t(row.group)}</dt>
            <dd>
              <p class="spec-fact">{t(row.fact)}<span>{t(row.name)}</span></p>
              <p set:html={t(row.note)} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
