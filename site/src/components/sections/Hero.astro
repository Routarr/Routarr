---
import { useTranslations, pathFor, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/* The second button leaves the page: what it offers is the whole detail page,
   which is where the sections this one dropped now live. */
const detail = pathFor(locale, 'how');

/**
 * The board announces six departures from the demonstration library. Titles,
 * folders and instances are the library's own words and read the same in every
 * language; the rule names and the statuses come from the catalogue. A row
 * carries only what the application's own plan shows, so the board promises
 * nothing the product does not say.
 */
type Kind = 'go' | 'confirm' | 'still';
interface Departure {
  title: string;
  rule: { number: string; name: Key } | null;
  from: string;
  to: string;
  gate: 'Radarr' | 'Sonarr';
  status: Key;
  kind: Kind;
}

const DEPARTURES: Departure[] = [
  {
    title: 'Akira (1988)', rule: { number: '#10', name: 'page.text.3' }, from: '/movies', to: '/movies/anime',
    gate: 'Radarr', status: 'hero.status.proposed', kind: 'go',
  },
  {
    title: 'Stop Making Sense', rule: { number: '#20', name: 'page.text.6' }, from: '/movies', to: '/movies/concerts',
    gate: 'Radarr', status: 'hero.status.proposed', kind: 'go',
  },
  {
    title: 'Cowboy Bebop', rule: { number: '#10', name: 'page.text.3' }, from: '/tv', to: '/tv/anime',
    gate: 'Sonarr', status: 'hero.status.confirm', kind: 'confirm',
  },
  {
    title: 'Paddington 2', rule: { number: '#30', name: 'page.text.8' }, from: '/movies', to: '/movies/kids',
    gate: 'Radarr', status: 'hero.status.proposed', kind: 'go',
  },
  {
    title: 'Whiplash', rule: null, from: '/movies', to: '/movies',
    gate: 'Radarr', status: 'hero.status.stays', kind: 'still',
  },
  {
    title: 'Homecoming', rule: { number: '#20', name: 'page.text.6' }, from: '/movies/concerts', to: '/movies/concerts',
    gate: 'Radarr', status: 'hero.status.in-place', kind: 'still',
  },
];

/* Two rows carry the explanation under the plan: one where every condition
   held, and one where the first rule was asked, failed, and the next took it.
   A pair of successes would show the panel without showing what it is for. */

const STATUS_CLASS: Record<Kind, string> = { go: 'is-go', confirm: 'is-confirm', still: 'is-still' };
const LEGEND: { cls: string; label: Key; note: Key }[] = [
  { cls: 'is-go', label: 'hero.status.proposed', note: 'hero.legend.proposed' },
  { cls: 'is-confirm', label: 'hero.status.confirm', note: 'hero.legend.confirm' },
  { cls: 'is-still', label: 'hero.status.stays', note: 'hero.legend.stays' },
  { cls: 'is-still', label: 'hero.status.in-place', note: 'hero.legend.in-place' },
];
---

<section class="hero">
  <div class="wrap">
    <div class="hero-head">
      <span class="eyebrow">{t('page.span')}</span>
      <h1 set:html={t('page.h1')} />
    </div>
    <div class="hero-lower">
      <p class="lead" set:html={t('page.p')} />
      <div class="hero-actions">
        <div class="hero-cta">
          <a class="btn btn-primary" href="#start">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            {t('page.a.get-started')}
          </a>
          <a class="btn btn-secondary" href={detail}>{t('page.a')}</a>
        </div>
        <p class="hero-note">{t('page.p.2')}</p>
      </div>
    </div>

    {/* The plan, as the application draws it. The columns are the ones the
        simulation screen shows, and every reason below is an `expected ·
        observed` pair the explanation panel produces, so nothing here promises
        what the product does not say. */}
    <div class="plan">
      <div class="plan-head">
        <span class="plan-title">{t('hero.plan')}</span>
        <span class="chip is-go">{t('hero.board.mode')}</span>
        <span class="plan-tally">{t('hero.tally')}</span>
      </div>

      {/* A region that scrolls has to be reachable from the keyboard, or the
          rows past the edge belong to the mouse alone. axe names it
          `scrollable-region-focusable`; the application reconciles the same
          rule in `TableRegion`. */}
      <div class="table-scroll" role="region" aria-label={t('hero.plan')} tabindex="0">
        <table class="plan-table">
          <caption class="sr-only">{t('hero.caption')}</caption>
          <thead>
            <tr>
              <th scope="col">{t('hero.col.title')}</th>
              <th scope="col">{t('hero.col.rule')}</th>
              <th scope="col">{t('hero.col.destination')}</th>
              <th scope="col">{t('hero.col.gate')}</th>
              <th scope="col">{t('hero.col.status')}</th>
            </tr>
          </thead>
          <tbody>
            {
              DEPARTURES.map((d) => (
                <tr>
                  <td class="plan-name">{d.title}</td>
                  <td class="plan-rule">
                    {d.rule ? <><b>{d.rule.number}</b>{t(d.rule.name)}</> : <i>{t('hero.rule.none')}</i>}
                  </td>
                  <td class="plan-dest">
                    <span class="mono from">{d.from}</span>
                    {d.kind === 'still' ? null : <><span class="arrow dir-aware" aria-hidden="true">&rarr;</span><span class="mono to">{d.to}</span></>}
                  </td>
                  <td class="plan-gate">{d.gate}</td>
                  <td><span class={`chip ${STATUS_CLASS[d.kind]}`}>{t(d.status)}</span></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="plan-legend">
        {LEGEND.map((l) => (
          <span><span class={`chip ${l.cls}`}>{t(l.label)}</span>{t(l.note)}</span>
        ))}
      </p>

    </div>
  </div>
</section>
