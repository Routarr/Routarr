---
import { useTranslations, pathFor, type Key, type Locale } from '../../i18n';
import Arrow from '../icons/Arrow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/* The second button leaves the page: it offers the whole detail page, where
   the sections the landing leaves out live. */
const detail = pathFor(locale, 'how');

/**
 * The plan shows six titles of the demonstration library, routed by the rules
 * the explanation cards show. Titles, folders and instances are the library's
 * own words and read the same in every language. The statuses, the default
 * category and the tally are the simulation screen's own words, which
 * `TERMS` in `check.mjs` holds to the application's dictionaries.
 */
type Kind = 'go' | 'still';
interface Departure {
  title: string;
  rule: { number: string; name: Key } | null;
  from: string;
  to: string;
  instance: 'Radarr' | 'Sonarr';
  status: Key;
  kind: Kind;
}

const DEPARTURES: Departure[] = [
  {
    title: 'Akira (1988)', rule: { number: '#10', name: 'page.text.3' }, from: '/movies', to: '/movies/anime',
    instance: 'Radarr', status: 'hero.status.move', kind: 'go',
  },
  {
    title: 'Stop Making Sense', rule: { number: '#20', name: 'page.text.6' }, from: '/movies', to: '/movies/concerts',
    instance: 'Radarr', status: 'hero.status.move', kind: 'go',
  },
  {
    title: 'Cowboy Bebop', rule: { number: '#10', name: 'page.text.3' }, from: '/tv', to: '/tv/anime',
    instance: 'Sonarr', status: 'hero.status.move', kind: 'go',
  },
  {
    title: 'Paddington 2', rule: { number: '#30', name: 'page.text.8' }, from: '/movies', to: '/movies/kids',
    instance: 'Radarr', status: 'hero.status.move', kind: 'go',
  },
  {
    title: 'Whiplash', rule: null, from: '/movies', to: '/movies',
    instance: 'Radarr', status: 'hero.status.correct', kind: 'still',
  },
  {
    title: 'Homecoming', rule: { number: '#20', name: 'page.text.6' }, from: '/movies/concerts', to: '/movies/concerts',
    instance: 'Radarr', status: 'hero.status.correct', kind: 'still',
  },
];

const STATUS_CLASS: Record<Kind, string> = { go: 'is-go', still: 'is-still' };
const LEGEND: { cls: string; label: Key; note: Key }[] = [
  { cls: 'is-go', label: 'hero.status.move', note: 'hero.legend.move' },
  { cls: 'is-still', label: 'hero.status.correct', note: 'hero.legend.correct' },
];
---

<section class="hero">
  <div class="wrap">
    <div class="hero-head">
      <span class="eyebrow">{t('page.span')}</span>
      <h1 set:html={t('page.h1')} />
    </div>
    <div class="hero-lower">
      <p class="lead" set:html={t('page.p')} />
      <div class="hero-actions">
        <div class="hero-cta">
          <a class="btn btn-primary" href="#start">
            <Arrow />
            {t('page.a.get-started')}
          </a>
          <a class="btn btn-secondary" href={detail}>{t('page.a')}</a>
        </div>
        <p class="hero-note">{t('page.p.2')}</p>
      </div>
    </div>

    {/* The plan, as the application holds it. Each column is something the
        simulation screen shows for a title, the instance under its name and
        the status as its action. A guardrail asks about an apply, never about
        one title, so no row asks. */}
    <div class="plan">
      <div class="plan-head">
        <span class="plan-title">{t('hero.plan')}</span>
        <span class="chip is-go">{t('hero.board.mode')}</span>
        <span class="plan-tally">{t('hero.tally')}</span>
      </div>

      {/* A region that scrolls has to be reachable from the keyboard, or the
          rows past the edge belong to the mouse alone. axe names it
          `scrollable-region-focusable`, and the application reconciles the
          same rule in `TableRegion`. */}
      <div class="table-scroll" role="region" aria-label={t('hero.plan')} tabindex="0">
        <table class="plan-table">
          <caption class="sr-only">{t('hero.caption')}</caption>
          <thead>
            <tr>
              <th scope="col">{t('hero.col.title')}</th>
              <th scope="col">{t('hero.col.rule')}</th>
              <th scope="col">{t('hero.col.destination')}</th>
              <th scope="col">{t('hero.col.instance')}</th>
              <th scope="col">{t('hero.col.status')}</th>
            </tr>
          </thead>
          <tbody>
            {
              DEPARTURES.map((d) => (
                <tr>
                  <td class="plan-name">{d.title}</td>
                  <td class="plan-rule">
                    {d.rule ? <><b>{d.rule.number}</b> {t(d.rule.name)}</> : <i>{t('hero.rule.default')}</i>}
                  </td>
                  <td class="plan-dest">
                    <span class="mono from">{d.from}</span>
                    {d.kind === 'still' ? null : <><span class="arrow" aria-hidden="true">&rarr;</span><span class="sr-only"> {t('hero.to')} </span><span class="mono to">{d.to}</span></>}
                  </td>
                  <td class="plan-instance">{d.instance}</td>
                  <td><span class={`chip ${STATUS_CLASS[d.kind]}`}>{t(d.status)}</span></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="plan-legend">
        {LEGEND.map((l) => (
          <span><span class={`chip ${l.cls}`}>{t(l.label)}</span>{t(l.note)}</span>
        ))}
      </p>

    </div>
  </div>
</section>
