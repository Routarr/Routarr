---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * Arr folders and declared folders in one table, told apart by the origin column. Paths,
 * instances and categories are the operator's own words, so only the origins and states
 * are translated. The grid carries table roles so a screen reader names each column.
 */
interface Folder { path: string; instance: string; declared: boolean; free: number | null; category: string | null }
const FOLDERS: Folder[] = [
  { path: '/movies', instance: 'Radarr', declared: false, free: 2.4, category: 'standard' },
  { path: '/movies/anime', instance: 'Radarr', declared: true, free: 2.4, category: 'anime' },
  { path: '/movies/kids', instance: 'Radarr', declared: true, free: 2.4, category: 'kids' },
  { path: '/movies/concerts', instance: 'Radarr', declared: true, free: 2.4, category: 'concerts' },
  { path: '/tv', instance: 'Sonarr', declared: false, free: 6.1, category: 'standard' },
  { path: '/tv/anime', instance: 'Sonarr', declared: false, free: 6.1, category: 'anime' },
  { path: '/mnt/archive', instance: 'Sonarr', declared: false, free: null, category: null },
];
// As the application writes a size: the reader's number format and unit.
const size = new Intl.NumberFormat(Astro.props.locale, {
  style: 'unit',
  unit: 'terabyte',
  unitDisplay: 'short',
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const COLUMNS: Key[] = ['folders.col.path', 'folders.col.instance', 'folders.col.origin', 'folders.col.free', 'folders.col.category'];
---

<section id="folders">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('folders.span')}</span>
      <h2 set:html={t('folders.h2')} />
      <p set:html={t('folders.p')} />
    </div>

    <div class="folders">
      <div class="folder-table" role="table" aria-label={t('folders.span')}>
        <div class="folder-row folder-head" role="row">
          {COLUMNS.map((column) => <span role="columnheader">{t(column)}</span>)}
        </div>
        {
          FOLDERS.map((folder) => (
            <div class="folder-row" role="row">
              <span class="folder-path" role="cell">{folder.path}</span>
              <span class="folder-instance" role="cell">{folder.instance}</span>
              <span role="cell" class:list={['folder-origin', { declared: folder.declared }]}>
                {t(folder.declared ? 'folders.origin.declared' : 'folders.origin.arr')}
              </span>
              <span class="folder-free" role="cell">
                <span class:list={['folder-dot', { off: !folder.free }]} aria-hidden="true" />
                {folder.free === null ? t('folders.unreachable') : size.format(folder.free)}
              </span>
              <span role="cell" class:list={['folder-cat', { none: !folder.category }]}>
                {folder.category ?? t('folders.unmapped')}
              </span>
            </div>
          ))
        }
      </div>
      <p class="folder-foot"><span>{t('folders.foot')}</span><span>{t('folders.foot.2')}</span></p>
    </div>

    <p class="folders-note" set:html={t('folders.p.2')} />
  </div>
</section>
