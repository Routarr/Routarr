---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * The context, in two halves: the gap stated in prose, then the four steps
 * that close it. They were two sections of the same weight side by side, which
 * put 4.1 phone screens of argument between the demonstration above and the
 * specifics below.
 *
 * The gap used to be drawn as a ledger of five films all landing in one
 * folder. That was the setup for a second ledger showing the same five routed,
 * and the contrast was the argument; with `explain` now opening the page the
 * second one only repeated it, and the first alone spent five rows saying
 * `/movies` five times. The heading and its sentence say it, and `explain`
 * shows it.
 *
 * The steps keep `id="how"` so the index's own entry still resolves. A
 * heading is not an anchor, and an index that points at a section the page no
 * longer has is a fault this header has already shipped once.
 */

const STEPS: { number: string; name: Key; note: Key; reads: Key | string; writes: Key }[] = [
  { number: '01', name: 'how.h3', note: 'how.p.2', reads: 'Radarr, Sonarr', writes: 'how.writes' },
  { number: '02', name: 'how.h3.2', note: 'how.p.3', reads: 'TMDb, AniList, OMDb…', writes: 'how.writes.2' },
  { number: '03', name: 'how.h3.3', note: 'how.p.4', reads: 'how.reads.3', writes: 'how.writes.3' },
  { number: '04', name: 'how.h3.4', note: 'how.p.5', reads: 'how.reads.4', writes: 'how.writes.4' },
];
const reading = (value: Key | string) => (value.includes(' ') && !value.startsWith('how.') ? value : t(value as Key));
---

<section id="why">
  <div class="wrap">
    <div class="section-head section-head-tight">
      <span class="eyebrow">{t('why.span')}</span>
      <h2 set:html={t('why.h2')} />
      {/* The gap, then the answer to it, in that order and as two paragraphs.
          The heading asserts that the Arrs know and do not choose, and the
          answer below used to follow it directly: what they actually carry
          and what becomes of it was shown by a ledger of five films, not
          said, so removing the ledger left the claim with nothing under it. */}
      <p>{t('why.p')}</p>
      <p set:html={t('why.p.2')} />
    </div>

    <div id="how" class="half">
      <div class="half-head">
        <h3 set:html={t('how.h2')} />
        <p>{t('how.p')}</p>
      </div>

      {/* A flow, not a table. A sequence is not a grid: its rows have an
          order and only two of its cells are alike, so the ordering is the
          number and the pair is labelled per step rather than by a heading
          three rows up. It is also the page's answer to carrying six framed
          grids with banded headers where the landing carries one. */}
      <ol class="flow">
        {
          STEPS.map((step, index) => (
            <li class:list={['flow-step', { 'flow-writes': index === STEPS.length - 1 }]}>
              <span class="flow-n">{step.number}</span>
              <div class="flow-body">
                <h4>{t(step.name)}</h4>
                <p>{t(step.note)}</p>
              </div>
              <p class="flow-k">
                <span><i>{t('how.band.reads')}</i>{reading(step.reads)}</span>
                <span class="flow-k-writes"><i>{t('how.band.writes')}</i>{t(step.writes)}</span>
              </p>
            </li>
          ))
        }
      </ol>
      <p class="flow-foot"><span>{t('how.foot')}</span><span set:html={t('how.foot.2')} /></p>
    </div>
  </div>
</section>
