---
import RefFields from '../RefFields.astro';
import TypeName from '../TypeName.astro';
import { groups, types } from '../../contract';
import { version } from '../../version';
import { useTranslations, type Key, type Locale } from '../../i18n';

/**
 * Every operation the release the page names offers, grouped as the contract
 * groups them, then every type they name. Each one opens on what it takes and
 * the top level of what it answers, with no script: a `<details>` folds
 * itself. Each entry's id is its `operationId`, or `schema-` and the type's
 * name, so a link can name one.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* Keys built from the contract's own names, which `check.mjs` holds to it. */
const tagName = (tag: string) => t(`api.ref.tag.${tag}` as Key);
const tagNote = (tag: string) => t(`api.ref.tag.${tag}.note` as Key);
const does = (id: string) => t(`api.ref.op.${id}` as Key);
---

<section id="api-reference">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('api.ref.span')}</span>
      <h2 set:html={t('api.ref.h2')} />
      <p>{t('api.ref.p').replace('{version}', version)}</p>
    </div>

    {
      groups.map((group) => (
        <div class="ref-group">
          <h3>{tagName(group.tag)}</h3>
          <p class="ref-note">{tagNote(group.tag)}</p>
          {group.operations.map((op) => (
            <details class="ref-op" id={op.id}>
              <summary>
                <span class={`ref-method ref-${op.method.toLowerCase()}`}>{op.method}</span>
                <code class="ref-path">{op.path}</code>
                <span class="ref-does">{does(op.id)}</span>
                <span class="ref-scope">
                  <span class="sr-only">, {t('api.ref.scope')} </span>
                  {op.scope ?? t('api.ref.open')}
                </span>
              </summary>
              <div class="ref-detail">
                {op.params.length === 0 && op.body.length === 0 && (
                  <p class="ref-label">{t('api.ref.nothing')}</p>
                )}
                {op.params.length > 0 && (
                  <>
                    <p class="ref-label">{t('api.ref.params')}</p>
                    <RefFields fields={op.params} locale={locale} />
                  </>
                )}
                {op.body.length > 0 && (
                  <>
                    <p class="ref-label">{t('api.ref.body')}</p>
                    <RefFields fields={op.body} locale={locale} />
                  </>
                )}
                {op.answer && (
                  <>
                    <p class="ref-label">
                      {t('api.ref.answer')} <code>{op.answer.status}</code>
                      {op.answer.type && <TypeName type={op.answer.type} />}
                    </p>
                    {op.answer.fields.length > 0 && (
                      <RefFields fields={op.answer.fields} locale={locale} required={false} />
                    )}
                  </>
                )}
              </div>
            </details>
          ))}
        </div>
      ))
    }

    <div class="ref-group">
      <h3>{t('api.ref.types')}</h3>
      <p class="ref-note">{t('api.ref.types.note')}</p>
      {
        types.map((type) => (
          <details class="ref-op" id={`schema-${type.name}`}>
            <summary>
              <code class="ref-path">{type.name}</code>
            </summary>
            <div class="ref-detail">
              {type.kind === 'fields' &&
                (type.fields.length > 0 ? (
                  <RefFields fields={type.fields} locale={locale} />
                ) : (
                  <p class="ref-label">{t('api.ref.empty')}</p>
                ))}
              {type.kind === 'values' && (
                <>
                  <p class="ref-label">{t('api.ref.values')}</p>
                  <ul class="ref-values">
                    {type.values.map((value) => (
                      <li>
                        <code>{value}</code>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {type.kind === 'variants' && (
                <>
                  <p class="ref-label">
                    {t('api.ref.variants')} <code>{type.by}</code>
                  </p>
                  <dl class="ref-fields">
                    {type.variants.map((variant) => (
                      <>
                        <dt>
                          <code>{variant.tag}</code>
                        </dt>
                        <dd>
                          {variant.fields.map((field, at) => (
                            <>
                              {at > 0 && ' · '}
                              <code>{field.name}</code> <TypeName type={field.type} />
                            </>
                          ))}
                        </dd>
                      </>
                    ))}
                  </dl>
                </>
              )}
              {type.kind === 'list' && (
                <p class="ref-label">
                  {t('api.ref.list')} <TypeName type={type.of} />
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
