---
import Terminal from '../Terminal.astro';
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * The four commands in the order you type them, as one list, because the
 * sequence is strictly linear. The reason for the first command, which is the
 * one people get wrong, is a line under the command it explains rather than a
 * comment in a terminal beside it.
 */
const STEPS: { number: string; command: string; prompt: boolean; note?: Key }[] = [
  { number: '01', command: 'mkdir -p config && sudo chown 1000:1000 config', prompt: true, note: 'start.step' },
  /* No note: the sentence above already says one image carries both, and a
     line repeating it under the command is the kind of detail that makes a
     page long without making it clearer. */
  { number: '02', command: 'docker compose up -d', prompt: true },
  { number: '03', command: 'docker exec routarr cat /config/routarr.api_key', prompt: true, note: 'start.step.3' },
  { number: '04', command: 'http://localhost:9876', prompt: false, note: 'start.step.4' },
];

/* The compose file, its keys and its values marked for the eye. */
const COMPOSE = `<span class="k">services</span>:
  <span class="k">routarr</span>:
    <span class="k">image</span>: <span class="s">ghcr.io/routarr/routarr:latest</span>
    <span class="k">container_name</span>: <span class="s">routarr</span>
    <span class="k">ports</span>:
      - <span class="s">"9876:9876"</span>
    <span class="k">volumes</span>:
      - <span class="s">./config:/config</span>
    <span class="k">restart</span>: <span class="s">unless-stopped</span>
    <span class="k">stop_grace_period</span>: <span class="s">30s</span>
    <span class="k">cap_drop</span>:
      - <span class="s">ALL</span>
    <span class="k">security_opt</span>:
      - <span class="s">no-new-privileges:true</span>`;
---

<section id="start">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('start.span')}</span>
      <h2 set:html={t('start.h2')} />
      <p>{t('start.p')}</p>
    </div>

    <div class="install">
      <ol class="install-steps">
        {
          STEPS.map((step) => (
            <li>
              <span class="install-n">{step.number}</span>
              <div>
                <p class:list={['install-cmd', { url: !step.prompt }]}>
                  {step.prompt && <span class="install-prompt" aria-hidden="true">$</span>}
                  {step.command}
                </p>
                {step.note && <p class="install-note" set:html={t(step.note)} />}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="install-aside">
        <Terminal locale={Astro.props.locale} name="docker-compose.yml" markup={COMPOSE} />

      </div>
    </div>

    {/* Out of the right column and under both: it is the one sentence here
        that is not about a step, and squeezed beside the compose file it would
        read as a footnote to the file rather than as the warning it is. */}
    <div class="callout callout-key">
      <p set:html={t('start.p.3')} />
    </div>
  </div>
</section>
