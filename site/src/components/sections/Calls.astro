---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * What every call has in common, before any recipe: the six things a client
 * is written against. The same shape as the specification on the detail page,
 * a term, the fact a client types, and what it means, so it is the same list
 * of definitions. The fact is what goes on the wire, which no language
 * translates.
 */
const FACTS: { term: Key; fact: string; note: Key }[] = [
  { term: 'api.calls.k', fact: 'X-Api-Key: rtr_…', note: 'api.calls.note' },
  { term: 'api.calls.k.2', fact: 'read · operate · write', note: 'api.calls.note.2' },
  { term: 'api.calls.k.3', fact: '409 confirmation_required', note: 'api.calls.note.3' },
  { term: 'api.calls.k.4', fact: 'Prefer: respond-async', note: 'api.calls.note.4' },
  { term: 'api.calls.k.5', fact: 'webhook-signature: v1,…', note: 'api.calls.note.5' },
  { term: 'api.calls.k.6', fact: '/api/v1', note: 'api.calls.note.6' },
];
---

<section id="calls">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('api.calls.span')}</span>
      <h2 set:html={t('api.calls.h2')} />
      <p>{t('api.calls.p')}</p>
    </div>

    <dl class="spec">
      {
        FACTS.map((row) => (
          <div class="spec-item">
            <dt>{t(row.term)}</dt>
            <dd>
              <p class="spec-fact"><code>{row.fact}</code></p>
              <p set:html={t(row.note)} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
