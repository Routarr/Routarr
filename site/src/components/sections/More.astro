---
import { useTranslations, pathFor, type Locale } from '../../i18n';
import { DETAIL_SECTIONS } from '../../detail-sections';
import Arrow from '../icons/Arrow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * The door to the second page, and the landing page's last block.
 *
 * It names what is behind it rather than saying "learn more": the six subjects
 * are the reason somebody clicks, and a reader who wants none of them has
 * finished the page instead of scrolling through them.
 *
 * They sit in a card with a header band, which is the shape every other object
 * on this page has. Set as bare rows with hairlines they would read a tone
 * below the rest, not because a contents list is the wrong thing to show, but
 * because it would be the only thing here not speaking the page's own
 * vocabulary.
 */
const href = pathFor(locale, 'how');
---

<section id="more">
  <div class="wrap more">
    <div class="more-say">
      <span class="eyebrow">{t('more.span')}</span>
      <h2 set:html={t('more.h2')} />
      <p>{t('more.p')}</p>
      <a class="btn btn-primary" href={href}>
        <Arrow />
        {t('more.cta')}
      </a>
    </div>

    <div class="more-card">
      <p class="more-band">{t('more.band')}</p>
      <ul class="more-list">
        {DETAIL_SECTIONS.map((section) => (
          <li>
            <i aria-hidden="true">{section.number}</i>
            <a href={`${href}${section.href}`}>{t(section.label)}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
