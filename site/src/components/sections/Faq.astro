---
import { useTranslations, type Key, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);

/**
 * These are not questions, they are objections: what somebody weighs before
 * letting software touch their library. Six of the seven answers are no, and
 * the third column names the thing in the product that answers each one, so a
 * reassurance becomes something the reader can go and check.
 *
 * The objection and its verdict are never folded away, which is what an
 * accordion over the whole row got wrong: six noes are an argument only when
 * they are read together. What folds is the justification under the
 * mechanism, which measured 1055px of a 2247px section on a 390px phone.
 */
type Verdict = 'no' | 'yes' | 'plain';
const OBJECTIONS: { worry: Key; verdict: Key; kind: Verdict; mechanism: Key; detail: Key }[] = [
  { worry: 'faq.summary', verdict: 'faq.v', kind: 'no', mechanism: 'faq.m', detail: 'faq.p' },
  { worry: 'faq.summary.2', verdict: 'faq.v.2', kind: 'no', mechanism: 'faq.m.2', detail: 'faq.p.2' },
  { worry: 'faq.summary.3', verdict: 'faq.v.3', kind: 'no', mechanism: 'faq.m.3', detail: 'faq.p.3' },
  { worry: 'faq.summary.4', verdict: 'faq.v.4', kind: 'no', mechanism: 'faq.m.4', detail: 'faq.p.4' },
  { worry: 'faq.summary.5', verdict: 'faq.v.5', kind: 'no', mechanism: 'faq.m.5', detail: 'faq.p.5' },
  { worry: 'faq.summary.6', verdict: 'faq.v.6', kind: 'yes', mechanism: 'faq.m.6', detail: 'faq.p.6' },
  { worry: 'faq.summary.7', verdict: 'faq.v.7', kind: 'plain', mechanism: 'faq.m.7', detail: 'faq.p.7' },
];
---

<section id="faq">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('faq.span')}</span>
      <h2 set:html={t('faq.h2')} />
      <p>{t('faq.lead')}</p>
    </div>

    <div class="objections">
      <p class="objection objection-head">
        <span>{t('faq.band.worry')}</span><span>{t('faq.band.answer')}</span><span>{t('faq.band.guarantee')}</span>
      </p>
      {
        OBJECTIONS.map((row) => (
          <div class="objection">
            <h3>{t(row.worry)}</h3>
            <p class:list={['objection-verdict', row.kind]}>{t(row.verdict)}</p>
            <div>
              <p class="objection-mechanism">{t(row.mechanism)}</p>
              <details class="objection-why">
                <summary aria-label={`${t('faq.detail.open')} — ${t(row.worry)}`}>
                  {t('faq.detail.open')}
                </summary>
                <p class="objection-detail" set:html={t(row.detail)} />
              </details>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
