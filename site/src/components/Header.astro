---
import { version } from '../version';
import { LANGUAGES, useTranslations, pathFor, type Key, type Locale, type Page } from '../i18n';
import { DETAIL_SECTIONS } from '../detail-sections';
import { API_SECTIONS } from '../api-sections';
import Brand from './icons/Brand.astro';
import GitHub from './icons/GitHub.astro';

interface Props { locale: Locale; page?: Page }
const { locale, page = 'landing' } = Astro.props;
const t = useTranslations(locale);

/**
 * One row, at every width. The language switch and the theme sit in the Index
 * panel rather than on the bar, where their chips and buttons would wrap onto
 * a second row on a phone before a word of the page. They are settings, they
 * are consulted once, and the panel is where a thing consulted once belongs.
 * `site.js` offers the reader's own language unprompted, so nothing depends on
 * finding the switch first.
 *
 * Each page lists its own sections. A panel naming anchors that are not on the
 * page scrolls nowhere, which is worse than not offering them.
 */
const LANDING: { number: string; href: string; label: Key; note: Key }[] = [
  { number: '01', href: '#rules', label: 'header.li.2', note: 'header.desc.2' },
  { number: '02', href: '#safety', label: 'header.li.4', note: 'header.desc.4' },
  { number: '03', href: '#start', label: 'header.li.5', note: 'header.desc.5' },
];

const SECTIONS: Record<Page, typeof LANDING> = { landing: LANDING, how: DETAIL_SECTIONS, api: API_SECTIONS };

/* After the page's own places, the doors to the other pages, so a reader
   reaches every page from the one panel. */
const PAGES: { page: Page; label: Key; note: Key }[] = [
  { page: 'landing', label: 'header.home', note: 'header.home.note' },
  { page: 'how', label: 'header.detail', note: 'header.detail.note' },
  { page: 'api', label: 'header.api', note: 'header.api.note' },
];
const crossLinks = PAGES.filter((other) => other.page !== page);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={pathFor(locale)}>
      <Brand />
      Routarr
    </a>
    <span class="version">v{version}</span>

    {/* A <details>, not a scripted menu: it opens and closes with no
         JavaScript at all, which is the property the rest of this page keeps.
         site.js only adds Ctrl K, Escape and closing on a click elsewhere. */}
    <details class="index">
      <summary>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
        <span class="index-label">{t('header.index')}</span>
        <kbd>{t('header.shortcut')}</kbd>
      </summary>
      <div class="index-panel">
        <nav class="index-nav" aria-label={t('header.nav.sections')}>
          {
            SECTIONS[page].map((section) => (
              <a href={section.href}>
                <i>{section.number}</i>
                <span><b>{t(section.label)}</b><p>{t(section.note)}</p></span>
              </a>
            ))
          }
          {
            crossLinks.map((other) => (
              <a class="cross" href={pathFor(locale, other.page)}>
                <i aria-hidden="true">&rarr;</i>
                <span><b>{t(other.label)}</b><p>{t(other.note)}</p></span>
              </a>
            ))
          }
        </nav>

        {/* Plain links, no script: the CSP allows one inline script and it is
             the theme bootstrap. Each one points at this same page in that
             language, so switching language never also changes the subject. */}
        <div class="index-settings">
          <nav class="seg lang-nav" aria-label={t('header.nav.language')}>
            {
              LANGUAGES.map((language) => (
                <a
                  href={pathFor(language.code, page)}
                  hreflang={language.code}
                  data-dismiss={language.dismiss}
                  data-offer={language.offer}
                  aria-current={language.code === locale ? 'page' : undefined}
                >
                  {language.label}
                </a>
              ))
            }
          </nav>

          {/* Both states are named rather than left to an icon. Which one is
               lit comes from `data-theme` in CSS, so it is right on the first
               paint. `aria-pressed` is site.js's, since without it the buttons
               do nothing anyway. */}
          <div class="seg theme-nav" role="group" aria-label={t('header.theme')}>
            <button type="button" data-theme-set="dark">{t('header.theme.dark')}</button>
            <button type="button" data-theme-set="light">{t('header.theme.light')}</button>
          </div>
        </div>
      </div>
    </details>

    {/* Beside the repository, where a developer looks for the API: the Index
         panel lists the page too, but a panel is opened to move within a page,
         not to find another one. */}
    <a class="icon-btn text-btn" href={pathFor(locale, 'api')} aria-current={page === 'api' ? 'page' : undefined}>{t('header.api')}</a>
    <a class="icon-btn" href="https://github.com/Routarr/Routarr" aria-label={t('header.github')}>
      <GitHub />
    </a>
  </div>
</header>
