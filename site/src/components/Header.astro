---
import { version } from '../version';
import { LANGUAGES, useTranslations, pathFor, type Key, type Locale, type Page } from '../i18n';

interface Props { locale: Locale; page?: Page }
const { locale, page = 'landing' } = Astro.props;
const t = useTranslations(locale);

/**
 * One row, at every width. The language switch and the theme used to sit on
 * the bar beside the Index control: six chips and two buttons, which on a
 * 390px phone wrapped onto a second row and took 118px of an 844px screen
 * before a word of the page. They are settings, they are consulted once, and
 * the panel is where a thing consulted once belongs. `site.js` still offers
 * the reader's own language unprompted, so nothing depends on finding the
 * switch first.
 *
 * Each page lists its own sections. A panel naming anchors that are not on the
 * page scrolls nowhere, which is worse than not offering them.
 */
const LANDING: { number: string; href: string; label: Key; note: Key }[] = [
  { number: '01', href: '#rules', label: 'header.li.2', note: 'header.desc.2' },
  { number: '02', href: '#safety', label: 'header.li.4', note: 'header.desc.4' },
  { number: '03', href: '#start', label: 'header.li.5', note: 'header.desc.5' },
];

const DETAIL: { number: string; href: string; label: Key; note: Key }[] = [
  { number: '01', href: '#why', label: 'why.span', note: 'header.desc.7' },
  { number: '02', href: '#how', label: 'header.li', note: 'header.desc' },
  { number: '03', href: '#explain', label: 'explain.span', note: 'header.desc.8' },
  { number: '04', href: '#folders', label: 'folders.span', note: 'header.desc.9' },
  { number: '05', href: '#features', label: 'header.li.3', note: 'header.desc.3' },
  { number: '06', href: '#faq', label: 'header.li.6', note: 'header.desc.6' },
];

const sections = page === 'how' ? DETAIL : LANDING;
const crossLink = page === 'how'
  ? { href: pathFor(locale), label: t('header.home'), note: t('header.home.note') }
  : { href: pathFor(locale, 'how'), label: t('header.detail'), note: t('header.detail.note') };
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={pathFor(locale)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="#ffa500" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 3v12"/><path d="M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M15 6a9 9 0 0 0-9 9"/>
      </svg>
      Routarr
    </a>
    <span class="version">v{version}</span>

    {/* A <details>, not a scripted menu: it opens and closes with no
         JavaScript at all, which is the property the rest of this page keeps.
         site.js only adds Ctrl K, Escape and closing on a click elsewhere. */}
    <details class="index">
      <summary>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
        {t('header.index')}
        <kbd>Ctrl K</kbd>
      </summary>
      <div class="index-panel">
        <nav class="index-nav" aria-label={t('header.nav.sections')}>
          {
            sections.map((section) => (
              <a href={section.href}>
                <i>{section.number}</i>
                <span><b>{t(section.label)}</b><p>{t(section.note)}</p></span>
              </a>
            ))
          }
          <a class="cross" href={crossLink.href}>
            <i aria-hidden="true">&rarr;</i>
            <span><b>{crossLink.label}</b><p>{crossLink.note}</p></span>
          </a>
        </nav>

        {/* Plain links, no script: the CSP allows one inline script and it is
             the theme bootstrap. Each one points at this same page in that
             language, so switching language never also changes the subject. */}
        <div class="index-settings">
          <nav class="seg lang-nav" aria-label={t('header.nav.language')}>
            {
              LANGUAGES.map((language) => (
                <a
                  href={pathFor(language.code, page)}
                  hreflang={language.code}
                  data-dismiss={language.dismiss}
                  data-offer={language.offer}
                  aria-current={language.code === locale ? 'page' : undefined}
                >
                  {language.label}
                </a>
              ))
            }
          </nav>

          {/* Both states are named rather than left to an icon. Which one is
               lit comes from `data-theme` in CSS, so it is right on the first
               paint; `aria-pressed` is site.js's, since without it the buttons
               do nothing anyway. */}
          <div class="seg theme-nav" role="group" aria-label={t('header.theme')}>
            <button type="button" data-theme-set="dark">{t('header.theme.dark')}</button>
            <button type="button" data-theme-set="light">{t('header.theme.light')}</button>
          </div>
        </div>
      </div>
    </details>

    <a class="icon-btn" href="https://github.com/Routarr/Routarr" aria-label={t('header.github')}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12a11.5 11.5 0 0 0 7.9 10.9c.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.6 4.6 18.6 5 18.6 5c.6 1.7.2 2.9.1 3.2.8.9 1.2 1.9 1.2 3.2 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 23.5 12C23.5 5.7 18.3.5 12 .5z"/></svg>
    </a>
  </div>
</header>
