# Cloudflare Pages reads this file. Harmless on any other static host.
#
# The Content-Security-Policy is as tight as the page allows: the site makes no
# external request at all, so every directive can be 'self' or 'none' — and a
# resource type the page never loads (fonts, fetches, a manifest, `data:`
# images) gets no directive, so `default-src 'none'` refuses it. The one
# 'sha256-' is the theme bootstrap in <head>, which has to run before first
# paint to avoid a flash of the wrong theme — `node site/check.mjs` recomputes
# it and fails if the script was edited without updating this line.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-0NcntYkOqJMzoHSBAGPGUxxBmVhUtZXh1Lp7M4nrbjM='; style-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Fingerprint-free filenames, so the pages themselves must stay revalidated.
/
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

/fr/
  Cache-Control: public, max-age=0, must-revalidate

/de/
  Cache-Control: public, max-age=0, must-revalidate

/es/
  Cache-Control: public, max-age=0, must-revalidate

# The second page, in its four languages. Added with the page itself would have
# been the moment; `check.mjs` now fails a built page that has no rule here, so
# the ninth cannot be forgotten the way these four were.
/how/
  Cache-Control: public, max-age=0, must-revalidate

/fr/how/
  Cache-Control: public, max-age=0, must-revalidate

/de/how/
  Cache-Control: public, max-age=0, must-revalidate

/es/how/
  Cache-Control: public, max-age=0, must-revalidate

# Same reasoning: the root icon carries no fingerprint either, and a year-long
# immutable copy of a wrong icon is not something a deploy can take back.
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

# No blanket rule over `/assets/`: nothing in it carries a fingerprint, so a
# file added there tomorrow would otherwise be cached for a year on the first
# visit unless somebody remembered to carve it out. Each file states its own.
#
# `/assets/shots/*` stood here until the screenshots left the page. The rule
# named a directory that no longer ships, which is how a headers file rots; it
# is one block to write again the day a screenshot earns its place back, and
# the reasoning is the same as the icons below.

# Hand-placed, unfingerprinted, and replaced by `icons.mjs`.
# `/favicon.ico` at the root is already carved out for this exact reason; these
# three were missed because they sit one directory further in.
/assets/favicon.svg
  Cache-Control: public, max-age=604800
/assets/favicon-32.png
  Cache-Control: public, max-age=604800
/assets/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The card a link preview renders. Replaced in place like the rest, and a stale
# one is the first thing anybody sees of a shared link.
/assets/og.png
  Cache-Control: public, max-age=604800

# Astro fingerprints what it builds, so the filename changes whenever the bytes
# do and a year is safe.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The one asset under /assets/ that is hand-written and carries no fingerprint,
# so it must not inherit the rule above: editing it and deploying would reach
# nobody who had already loaded the page.
/assets/site.js
  Cache-Control: public, max-age=0, must-revalidate
