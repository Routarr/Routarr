# Cloudflare's static assets read this file. Harmless on any other static host.
#
# The Content-Security-Policy is as tight as the page allows: the site makes no
# external request at all, so every directive can be 'self' or 'none'. A
# resource type the page never loads (fonts, fetches, a manifest, `data:`
# images) gets no directive, so `default-src 'none'` refuses it. The one
# 'sha256-' is the theme bootstrap in <head>, which has to run before first
# paint to avoid a flash of the wrong theme. `node site/check.mjs` recomputes
# it and fails when the script changes and this line does not.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-0NcntYkOqJMzoHSBAGPGUxxBmVhUtZXh1Lp7M4nrbjM='; style-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Fingerprint-free filenames, so the pages themselves must stay revalidated.
/
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
/fr/404.html
  Cache-Control: public, max-age=0, must-revalidate
/de/404.html
  Cache-Control: public, max-age=0, must-revalidate
/es/404.html
  Cache-Control: public, max-age=0, must-revalidate

/fr/
  Cache-Control: public, max-age=0, must-revalidate

/de/
  Cache-Control: public, max-age=0, must-revalidate

/es/
  Cache-Control: public, max-age=0, must-revalidate

# The second page, in its four languages. `check.mjs` fails a built page that
# has no rule here.
/how/
  Cache-Control: public, max-age=0, must-revalidate

/fr/how/
  Cache-Control: public, max-age=0, must-revalidate

/de/how/
  Cache-Control: public, max-age=0, must-revalidate

/es/how/
  Cache-Control: public, max-age=0, must-revalidate

# Same reasoning: the root icon carries no fingerprint either, and a year-long
# immutable copy of a wrong icon is not something a deploy can take back.
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

# No blanket rule over `/assets/`: nothing in it carries a fingerprint, so a
# blanket rule would cache a file added there for a year on the first visit
# unless somebody remembered to carve it out. Each file states its own, and
# `check.mjs` fails a file under `/assets/` that has none.
#
# A page that shows a screenshot takes a bounded rule for `/assets/shots/*`
# here, for the same reason as the icons below.

# Hand-placed, unfingerprinted, and replaced by `icons.mjs`, like `/favicon.ico`
# at the root.
/assets/favicon.svg
  Cache-Control: public, max-age=604800
/assets/favicon-32.png
  Cache-Control: public, max-age=604800
/assets/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The card a link preview renders. Replaced in place like the rest, and a stale
# one is the first thing anybody sees of a shared link.
/assets/og.png
  Cache-Control: public, max-age=604800

# Astro fingerprints what it builds, so the filename changes whenever the bytes
# do and a year is safe.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidated on every load: an edit must reach a returning visitor at once.
/assets/site.js
  Cache-Control: public, max-age=0, must-revalidate
