{
  "name": "routarr-frontend",
  "private": true,
  "version": "0.1.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash e2e/run.sh --grep-invert @subpath",
    "test:e2e:base": "ROUTARR_E2E_BASE=/routarr bash e2e/run.sh --grep @subpath",
    "format": "prettier --write 'src/**/*.{ts,svelte,css}' 'e2e/**/*.ts' '*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,svelte,css}' 'e2e/**/*.ts' '*.{ts,js,json}'",
    "coverage": "vitest run --coverage",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p e2e --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
