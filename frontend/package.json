{
  "name": "routarr-frontend",
  "private": true,
  "version": "0.3.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash e2e/run.sh --grep-invert '@subpath|@forms|@oidc'",
    "test:e2e:base": "ROUTARR_E2E_BASE=/routarr bash e2e/run.sh --grep @subpath",
    "test:e2e:auth": "ROUTARR_E2E_AUTH=forms bash e2e/run.sh --grep @forms && ROUTARR_E2E_AUTH=oidc bash e2e/run.sh --grep @oidc",
    "format": "prettier --write 'src/**/*.{ts,svelte,css}' 'e2e/**/*.ts' '*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,svelte,css}' 'e2e/**/*.ts' '*.{ts,js,json}'",
    "coverage": "vitest run --coverage",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p e2e --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lucide/svelte": "^1.60.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "fast-check": "^4.10.2",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
