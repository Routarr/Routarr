{
  "name": "Routarr",
  "dockerFile": "Dockerfile",
  "context": "..",
  "workspaceFolder": "/workspaces/Routarr",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "esbenp.prettier-vscode",
        // The lint CI runs, seen in the editor: a floating promise underlined
        // where it is typed rather than in a red job an hour later.
        "dbaeumer.vscode-eslint",
        "svelte.svelte-vscode",
        "astro-build.astro-vscode",
        // Validates the workflows and shows a run's status in the editor.
        "github.vscode-github-actions",
        // Cargo.toml and rust-toolchain.toml.
        "tamasfe.even-better-toml",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "rust-analyzer.check.command": "clippy",
        // Named explicitly: there is no Cargo.toml at the repository root, and
        // a rust-analyzer that finds no project reports nothing.
        "rust-analyzer.linkedProjects": ["backend/Cargo.toml"],
        // The config sits in frontend/, not at the root the extension looks in.
        "eslint.workingDirectories": ["frontend"],
        "eslint.validate": ["javascript", "typescript", "svelte"],
        // Prettier owns .svelte through prettier-plugin-svelte, declared in
        // frontend/.prettierrc.json.
        "[svelte]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    }
  },
  "runArgs": [
    "--init",
    // A ramdisk for the Rust build tree, emptied at every stop. No `tmpfs-size`:
    // the kernel's default, half the RAM, follows the machine. `prune.sh` caps the
    // tree, and `ramdisk.sh` moves it to disk on a small machine.
    "--mount",
    "type=tmpfs,destination=/ramdisk,tmpfs-mode=1777"
  ],
  "containerEnv": {
    "CARGO_HOME": "/cargo",
    "PLAYWRIGHT_BROWSERS_PATH": "/playwright",
    // Unset outside this container, so no script assumes where the binary is.
    "CARGO_TARGET_DIR": "/ramdisk/cargo-target",
    // The mount point itself, which exists before `ramdisk.sh` runs.
    "TMPDIR": "/ramdisk"
  },
  // ~/.local/bin after the system directories, so the pinned tools still win.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },

  "mounts": [
    "source=routarr-cargo,target=/cargo,type=volume",
    "source=routarr-playwright,target=/playwright,type=volume",
    // Credentials and history a rebuild would wipe.
    "source=routarr-claude,target=/root/.claude,type=volume",
    // Same reason: a rebuild would silently sign `gh` out.
    "source=routarr-gh,target=/root/.config/gh,type=volume",
    // Extensions only: the rest of `.vscode-server` is bound to its build.
    "source=routarr-vscode-extensions,target=/root/.vscode-server/extensions,type=volume"
  ],
  // `;` and not `&&`: `ramdisk.sh` is advisory, and an unexpected failure in
  // it must not leave a container with no node_modules.
  "postCreateCommand": "bash .devcontainer/ramdisk.sh; bash .devcontainer/post-create.sh",
  // The tmpfs is empty after every start. `--daemon` is idempotent, and
  // `|| true` keeps a failed tidy-up from blocking the start.
  "postStartCommand": "bash .devcontainer/ramdisk.sh; bash .devcontainer/tools.sh; bash .devcontainer/prune.sh --daemon || true",
  "postAttachCommand": "bash .devcontainer/prune.sh --daemon || true",
  "remoteUser": "root",
  "forwardPorts": [
    9876,
    3000,
    8788
  ],
  "portsAttributes": {
    "9876": {
      "label": "Routarr (backend + built frontend)"
    },
    "3000": {
      "label": "Vite (dev, proxies /api to 9876)"
    },
    "8788": {
      "label": "Showcase site (node site/serve.mjs)"
    },
    "4321": {
      "label": "Showcase site (astro dev)"
    },
    "4173": {
      "label": "Vite preview of frontend/dist"
    }
  },
  // Unlisted ports are the tests' own (`frontend/e2e/run.sh` binds 9877, 7979 and 7980).
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
